# ==========================================
# MongoDB Connection
# ==========================================
# Get your MongoDB URI from MongoDB Atlas:
# 1. Go to https://cloud.mongodb.com/ and login
# 2. Create a new cluster (or use existing)
# 3. Click "Connect" -> "Drivers" -> "Node.js"
# 4. Copy the connection string and replace <db_password>
# 5. Replace myFirstDatabase with "etms"
#
# Example format:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/etms?retryWrites=true&w=majority
#
MONGODB_URI=your_mongodb_connection_string_here

# ==========================================
# JWT Secret
# ==========================================
# Generate a random string for JWT signing
# You can use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# ==========================================
# Server Port
# ==========================================
PORT=5000

# ==========================================
# Frontend URL (for CORS)
# ==========================================
# In development: http://localhost:5173
# In production: your_deployed_frontend_url
CLIENT_URL=http://localhost:5173

# ==========================================
# Environment
# ==========================================
# Set to 'production' when deploying to Railway
NODE_ENV=development
